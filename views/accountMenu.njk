{% extends "layout.njk" %}
{% block title %}Account Menu{% endblock %}
{% block header %}Account Menu{% endblock %}
{% block content %}
<main class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Account details</h2>
    <div class="bg-white border border-gray-200 rounded-lg p-6 mb-8 space-y-2">
        <p class="text-gray-700"><span class="font-semibold">Customer ID:</span> {{ customerId }}</p>
        <p class="text-gray-700"><span class="font-semibold">Name:</span> {{ firstName }} {{ lastName }}</p>
        <p class="text-gray-700"><span class="font-semibold">Email:</span> {{ email }}</p>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 mb-6">Order history</h2>
    <div class="space-y-6">
        {% for order in orders %}
        <div class="bg-white border border-gray-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Order ID: {{ order.orderID }}</h3>
            <p class="text-gray-700 mb-4"><span class="font-semibold">Price:</span> £{{ order.price | pounds }}</p>
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left px-3 py-2 font-semibold text-gray-900">Product</th>
                            <th class="text-left px-3 py-2 font-semibold text-gray-900">Quantity</th>
                            <th class="text-left px-3 py-2 font-semibold text-gray-900">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in order.orderItems %}
                        <tr class="border-b border-gray-200">
                            <td class="px-3 py-2 text-gray-700">{{ item.product.name }}</td>
                            <td class="px-3 py-2 text-gray-700">{{ item.quantity }}</td>
                            <td class="px-3 py-2 text-gray-700">£{{ (item.product.price*item.quantity) | pounds }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endfor %}
    </div>

    <h2 class="text-2xl font-bold text-gray-900 my-8">Account controls</h2>
    <form action="/logout" method="post">
        <button class="px-6 py-3 bg-amber-700 text-white rounded-md hover:bg-amber-600 font-medium" data-test-id="logout-button" type="submit">Logout</button>
    </form>
</main>
{% endblock %}
