{% extends "layout.njk" %}
{% block title %}{% if product %}{{ product.name }}{% else %}Product not found{% endif %} | Pending Studios{% endblock %}
{% block head %}
<link rel="stylesheet" type="text/css" href="/products.css">
{% endblock %}
{% block content %}
<main class="product-detail">
    <a href="/products">Back to all products</a>
    {% if product %}
    <article>
        <h2>{{ product.name }}</h2>
        {% if product.image %}<img class="product-detail-image" src="{{ product.image }}" alt="{{ product.name }}" width="320" height="320">{% endif %}
        <p>£{{ product.price | pounds }}</p>
        <p>{{ product.description }}</p>
        <p>Category: <a href="/products?category={{ product.category | urlencode }}">{{ product.category }}</a></p>
        {% if product.quantity > 0 %}
        <form action="/basket" method="post">
            <input type="hidden" name="id" value="{{ product.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="quantityMode" value="relative">
            <button type="submit" class="main-button">Add to Basket</button>
        </form>
        {% else %}
        <p>Out of stock</p>
        {% endif %}
    </article>
    {% else %}
    <h2>Product not found</h2>
    <p>This product is no longer available. Browse the catalogue to find something else.</p>
    {% endif %}
</main>
{% endblock %}
