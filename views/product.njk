{% extends "layout.njk" %}
{% block head %}
<link rel="stylesheet" href="/product.css">
{% endblock %}
{% block title %}{{ product.name }}{% endblock %}
{% block content %}
<main>
    <div class="horizontal">
        <div class="margin-auto">
            <img class="product-image" src="{{backendUrl}}{{ product.image }}" alt="{{ product.name }}">
        </div>
        <div class="product-description">
            <h1>{{ product.name }}</h1>
            <div class="stars" role="img"
                aria-label="{% if product.reviews.length %}Average rating: {{ stars }} out of 5 ({{ product.reviews.length }} reviews){% else %}No reviews yet{% endif %}">
                {% if stars >= 1 %}
                <img src="/star_full.svg" alt="Star">
                {% else %}
                <img src="/star_empty.svg" alt="Star">
                {% endif %}
                {% if stars >= 2 %}
                <img src="/star_full.svg" alt="Star">
                {% else %}
                <img src="/star_empty.svg" alt="Star">
                {% endif %}
                {% if stars >= 3 %}
                <img src="/star_full.svg" alt="Star">
                {% else %}
                <img src="/star_empty.svg" alt="Star">
                {% endif %}
                {% if stars >= 4 %}
                <img src="/star_full.svg" alt="Star">
                {% else %}
                <img src="/star_empty.svg" alt="Star">
                {% endif %}
                {% if stars >= 5 %}
                <img src="/star_full.svg" alt="Star">
                {% else %}
                <img src="/star_empty.svg" alt="Star">
                {% endif %}
                ({{ product.reviews.length }})
            </div>
            <p>{{ product.description }}</p>
            <form action="/basket" method="post" class="add-to-basket-form">
                <span>£{{ product.price | pounds }}</span>
                <input type="number" name="productID" hidden value="{{product.productID}}">
                <input type="number" name="quantity" hidden value="1">
                <input type="text" name="quantityMode" hidden value="relative">
                {% if product.quantity <= 0 %}
                <button type="submit" data-test-id="add-to-basket-button" class="main-button disabled-button"
                    disabled>Out of stock</button>
                {% else %}
                <button type="submit" data-test-id="add-to-basket-button" class="main-button" type="button">Add to
                    Basket</button>
                {% endif %}
            </form>

            <h2>Reviews</h2>
            <div class="review-form">
                Leave a review:
                <div class="stars">
                    {% for i in range(5) %}
                    <a data-test-id="add-review-link-{{i}}" aria-label="Rate {{ i + 1 }} out of 5 stars"
                        href="/products/{{product.productID}}/add_review?rating={{ i + 1 }}"><img src="/star_empty.svg"
                            alt=""></a>
                    {% endfor %}
                </div>
            </div>
            <br>

            <div class="reviews">
                {% for review in product.reviews %}
                <div class="review" data-test-id="review">
                    <div class="space-between">
                        <div class="stars">
                            {% if review.rating >= 1 %}
                            <img src="/star_full.svg" alt="Star">
                            {% else %}
                            <img src="/star_empty.svg" alt="Star">
                            {% endif %}
                            {% if review.rating >= 2 %}
                            <img src="/star_full.svg" alt="Star">
                            {% else %}
                            <img src="/star_empty.svg" alt="Star">
                            {% endif %}
                            {% if review.rating >= 3 %}
                            <img src="/star_full.svg" alt="Star">
                            {% else %}
                            <img src="/star_empty.svg" alt="Star">
                            {% endif %}
                            {% if review.rating >= 4 %}
                            <img src="/star_full.svg" alt="Star">
                            {% else %}
                            <img src="/star_empty.svg" alt="Star">
                            {% endif %}
                            {% if review.rating >= 5 %}
                            <img src="/star_full.svg" alt="Star">
                            {% else %}
                            <img src="/star_empty.svg" alt="Star">
                            {% endif %}
                        </div>
                        <div data-test-id="review-author">{{ review.customer.firstName }} {{ review.customer.lastName }}
                        </div>
                    </div>
                    <p data-test-id="review-comment">{{ review.comment }}</p>
                </div>
                {% endfor %}
            </div>

        </div>
    </div>
</main>
{% endblock %}