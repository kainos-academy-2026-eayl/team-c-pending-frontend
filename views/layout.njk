<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" type="text/css" href="/common.css">
    {% block head %}{% endblock %}
</head>

<body>
    <div class="content">
        <header>
            <h1><a href="/">Pending Studios</a></h1>
            <form action="/products" method="get" class="header-search" role="search">
                <label for="product-search" class="visually-hidden">Search products</label>
                <input type="search" id="product-search" name="q" placeholder="Search products..."
                    value="{{ searchQuery }}">
                {% if currentCategory %}
                <input type="hidden" name="category" value="{{ currentCategory }}">
                {% endif %}
                <button type="submit" class="main-button">Search</button>
            </form>
            <div class="links">
                {% if me %}
                <a href="/account" data-test-id="profile-button"><img src="/account.svg" alt="Account"></a>
                {% if me.role == "admin" %}<a href="/admin">Admin portal</a>{% endif %}
                <a href="/basket"><img src="/basket.svg" alt="Basket">{% if me.basketCount != 0 %}<span
                        class="basket-count">{{ me.basketCount }}</span>{% endif %}</a>
                {% else %}
                <a href="/login">Login</a>
                <a href="/register">Register</a>
                {% endif %}
            </div>
        </header>
        {% block content %}{% endblock %}
    </div>
</body>

</html>