{% extends "layout.njk" %}
{% block title %}Confirm deletion{% endblock %}
{% block content %}
<main class="max-w-2xl mx-auto px-4 py-8">
    <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Confirm deletion</h2>
        <p class="text-gray-700 mb-2">Delete customer #{{ id }} permanently? This also deletes all of their orders, order items, and basket entries.</p>
        <p class="text-red-600 font-semibold mb-6">This action cannot be undone.</p>
        <form action="/admin/customer/{{ id }}/delete?{{ filterQuery }}" method="post">
            <div class="flex gap-3">
                <button class="px-6 py-3 bg-red-600 text-white rounded-md hover:bg-red-700 font-medium" type="submit" name="confirm" value="delete">Confirm deletion</button>
                <a href="/admin/customers?{{ filterQuery }}" class="inline-flex items-center px-6 py-3 bg-gray-200 text-gray-900 rounded-md hover:bg-gray-300 font-medium">Cancel</a>
            </div>
        </form>
    </div>
</main>
{% endblock %}
