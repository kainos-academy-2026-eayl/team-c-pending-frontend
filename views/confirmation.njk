{% extends "layout.njk" %}
{% block title %}Confirmation Page{% endblock %}
{% block content %}
<main class="max-w-2xl mx-auto px-4 py-12 text-center">
    <h2 class="text-3xl font-bold text-gray-900 mb-4">Your order is confirmed</h2>
    <p class="text-gray-600 mb-3">Thank you for shopping with Pending Studios!</p>
