{% extends "layout.njk" %}
{% block title %}Leave a Review{% endblock %}
{% block content %}
<main class="max-w-md mx-auto mt-12 px-4 py-8 bg-white rounded-lg shadow-md">
    <form method="POST" action="/products/{{ product.productID }}/add_review">
        <a class="inline-flex items-center text-amber-700 hover:text-amber-600 mb-6" href="/products/{{ product.productID }}/add_review?rating={{ rating }}">
            <img class="w-5 h-5 mr-2" src="/back.svg" alt="Back">
            Back
        </a>
        <h1 class="text-2xl font-bold text-gray-900 mb-6">What did you think of {{ product.name }}?</h1>
        {% if error %}
        <p class="text-red-600 mb-4">{{ error }}</p>
        {% endif %}
        <div class="mb-6">
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message:</label>
            <textarea data-test-id="message" id="message" name="message" class="w-full px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600 resize-none" style="height: 10em;"></textarea>
        </div>
        <input type="hidden" name="rating" value="{{ rating }}">
        <button data-test-id="post-button" class="w-full px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600 font-medium" type="submit">Post</button>
    </form>
</main>
{% endblock %}
