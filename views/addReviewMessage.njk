{% extends "layout.njk" %}
{% block title %}Leave a Review{% endblock %}
{% block content %}
<form method="POST" action="/products/{{ product.productID }}/add_review" class="main-page-form">
    <a class="back-group" href="/products/{{ product.productID }}/add_review?rating={{ rating }}"><img class="back-icon"
            src="/back.svg" alt="Back">Back</a>
    <h1>What did you think of {{ product.name }}?</h1>
    {% if error %}
    <p style="color: red;">{{ error }}</p>
    {% endif %}
    <label for="message">Message:</label><br>
    <textarea data-test-id="message" id="message" name="message"></textarea>
    <input type="hidden" name="rating" value="{{ rating }}">
    <button data-test-id="post-button" class="main-button" data-test-id="post-button" type="submit">Post</button>
</form>
{% endblock %}
