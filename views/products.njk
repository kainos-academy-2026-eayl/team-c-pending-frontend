{% extends "layout.njk" %}
{% block head %}
<link rel="stylesheet" type="text/css" href="/products.css">
<script src="/search.js" defer></script>
{% if bestSellers.length %}
<script src="/products.js" defer></script>
{% endif %}
{% endblock %}
{% block title %}Products Page{% endblock %}
{% block header %}Products Page{% endblock %}
{% block content %}
{% if bestSellersError %}
<p class="best-sellers-error" role="status">Best sellers are unavailable right now. <a href="/">Try again</a> or browse all products below.</p>
{% elif bestSellers.length %}
<section class="best-sellers" aria-labelledby="best-sellers-title">
    <div class="best-sellers-heading">
        <h2 id="best-sellers-title">Best sellers</h2>
        <div class="globe-controls">
            <div class="globe-navigation" hidden>
                <button type="button" tabindex="-1" data-carousel-step="-1" aria-controls="best-sellers-globe" aria-label="Previous best seller">&lsaquo;</button>
                <button type="button" tabindex="-1" data-carousel-step="1" aria-controls="best-sellers-globe" aria-label="Next best seller">&rsaquo;</button>
            </div>
            <button class="globe-toggle" type="button" tabindex="-1" aria-controls="best-sellers-globe" aria-label="Pause rotation" title="Pause rotation" aria-pressed="false" hidden>
                <svg class="carousel-pause-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 3h3v10H4zm5 0h3v10H9z"/></svg>
                <svg class="carousel-play-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="m5 2 9 6-9 6z"/></svg>
            </button>
        </div>
    </div>
    <ul class="product-globe" id="best-sellers-globe">
        {% for product in bestSellers %}
        <li class="globe-item">
            <a class="globe-product" tabindex="-1" href="/products/{{ product.id }}">
                {% if product.image %}
                <img src="{{ product.image }}" alt="" width="56" height="56">
                {% endif %}
                <span class="globe-image-placeholder" {% if product.image %}hidden{% endif %}>No image</span>
                <span class="globe-product-name">{{ product.name }}</span>
                <span class="globe-product-price">£{{ product.price | pounds }}</span>
            </a>
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
<div class="categories-container">
    <a href="/products?q={{ searchQuery | urlencode }}" {% if not currentCategory %}class="active" {% endif %}>All</a>
    {% for category in categories %}
    <a href="/products?category={{ category | urlencode }}&amp;q={{ searchQuery | urlencode }}" {% if currentCategory==category %}class="active" {% endif %}>{{ category
        }}</a>
    {% endfor %}
</div>
<p id="search-status" role="status" aria-live="polite"></p>
<div class="products-container">
    {% for product in products %}
    <div class="product" data-test-id="product">
        <div>
            <img src="{{ product.image }}" alt="{{ product.name }}">
            <a href="/products/{{ product.productID }}">
                <h2 data-test-id="product-name">{{ product.name }}</h2>
            </a>
            <p>{{ product.description }}</p>
        </div>

        <form action="/basket" method="post" class="add-to-basket-form">
            <span>£{{ product.price | pounds }}</span>
            <input type="number" name="productID" hidden value="{{product.productID}}">
            <input type="number" name="quantity" hidden value="1">
            <input type="text" name="quantityMode" hidden value="relative">
            {% if product.quantity <= 0 %}
            <button type="submit" data-test-id="add-to-basket-button" class="main-button disabled-button"
                type="button">Out of
                stock</button>
            {% else %}
            <button type="submit" data-test-id="add-to-basket-button" class="main-button" type="button">Add to
                Basket</button>
            {% endif %}
        </form>
    </div>

    {% else %}
    <p role="status">No products match your search.</p>
    {% endfor %}
</div>
{% endblock %}