{% extends "layout.njk" %}
{% block head %}
<link rel="stylesheet" href="/carousel.css">
<script src="/search.js" defer></script>
{% if bestSellers.length %}
<script src="/products.js" defer></script>
{% endif %}
{% endblock %}
{% block title %}Products Page{% endblock %}
{% block header %}Products Page{% endblock %}
{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">
    {% if bestSellersError %}
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6 text-yellow-800">
        <p>Best sellers are unavailable right now. <a href="/" class="text-yellow-900 underline hover:no-underline">Try again</a> or browse all products below.</p>
    </div>
    {% elif bestSellers.length %}
    <section class="bg-white rounded-lg shadow-md p-6 mb-8" aria-labelledby="best-sellers-title">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
            <h2 id="best-sellers-title" class="text-xl font-bold text-gray-900">Best sellers</h2>
            <div class="flex items-center gap-2">
                <div id="globe-navigation" class="globe-navigation" hidden>
                    <button type="button" tabindex="-1" data-carousel-step="-1" aria-controls="best-sellers-globe" aria-label="Previous best seller" class="px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-100">&lsaquo;</button>
                    <button type="button" tabindex="-1" data-carousel-step="1" aria-controls="best-sellers-globe" aria-label="Next best seller" class="px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-100">&rsaquo;</button>
                </div>
                <button class="globe-toggle px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-100" type="button" tabindex="-1" aria-controls="best-sellers-globe"
                    aria-label="Pause rotation" title="Pause rotation" aria-pressed="false" hidden>
                    <svg class="carousel-pause-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M4 3h3v10H4zm5 0h3v10H9z" />
                    </svg>
                    <svg class="carousel-play-icon hidden" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="m5 2 9 6-9 6z" />
                    </svg>
                </button>
            </div>
        </div>
        <ul class="product-globe grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="best-sellers-globe">
            {% for product in bestSellers %}
            <li class="globe-item">
                <a class="globe-product flex flex-col items-center gap-2 p-4 bg-gray-50 rounded-lg hover:bg-gray-100 text-center text-gray-900 no-underline" tabindex="-1" href="/products/{{ product.id }}">
                    {% if product.image %}
                    <img src="{{backendUrl}}{{ product.image }}" alt="" class="w-14 h-14 object-contain rounded" width="56" height="56">
                    {% else %}
                    <div class="w-14 h-14 bg-gray-200 rounded flex items-center justify-center text-xs text-gray-500">No image</div>
                    {% endif %}
                    <span class="globe-product-name text-sm line-clamp-2">{{ product.name }}</span>
                    <span class="globe-product-price text-sm font-semibold text-gray-900">£{{ product.price | pounds }}</span>
                </a>
            </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}
    <div class="flex flex-wrap gap-2 justify-center mb-6">
        <a href="/products?q={{ searchQuery | urlencode }}" class="px-4 py-2 rounded-md border {% if not currentCategory %}bg-amber-700 text-white border-amber-700 hover:bg-amber-600{% else %}border-gray-300 text-gray-900 hover:bg-gray-100{% endif %}">All</a>
        {% for category in categories %}
        <a href="/products?category={{ category | urlencode }}&amp;q={{ searchQuery | urlencode }}" class="px-4 py-2 rounded-md border {% if currentCategory==category %}bg-amber-700 text-white border-amber-700 hover:bg-amber-600{% else %}border-gray-300 text-gray-900 hover:bg-gray-100{% endif %}">{{ category }}</a>
        {% endfor %}
    </div>
    <p id="search-status" role="status" aria-live="polite" class="text-center text-gray-600 mb-6"></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {% for product in products %}
        <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col" data-test-id="product">
            <div class="p-4 flex-1">
                <img src="{{backendUrl}}{{ product.image }}" alt="{{ product.name }}" class="w-full h-40 object-contain mb-4 rounded">
                <a href="/products/{{ product.productID }}" class="text-lg font-semibold text-gray-900 hover:text-amber-700 no-underline">
                    <h2 data-test-id="product-name">{{ product.name }}</h2>
                </a>
                <p class="text-sm text-gray-600 mb-4">{{ product.description }}</p>
            </div>
            <form action="/basket" method="post" class="p-4 border-t border-gray-200 flex items-center justify-between gap-4">
                <span class="text-lg font-semibold text-gray-900">£{{ product.price | pounds }}</span>
                <input type="number" name="productID" hidden value="{{product.productID}}">
                <input type="number" name="quantity" hidden value="1">
                <input type="text" name="quantityMode" hidden value="relative">
                {% if product.quantity <= 0 %}
                <button type="submit" data-test-id="add-to-basket-button" class="px-4 py-2 bg-gray-300 text-gray-600 rounded-md cursor-not-allowed pointer-events-none" disabled>Out of stock</button>
                {% else %}
                <button type="submit" data-test-id="add-to-basket-button" class="px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600">Add to Basket</button>
                {% endif %}
            </form>
        </div>
        {% else %}
        <p class="col-span-full text-center text-gray-600 py-8">No products match your search.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}