{% extends "layout.njk" %}
{% block content %}
<main class="max-w-2xl mx-auto px-4 py-8 text-center">
    <a class="inline-flex items-center text-amber-700 hover:text-amber-600 mb-6" href="/products/{{product.productID}}/">
        <img class="w-5 h-5 mr-2" src="/back.svg" alt="Back">
        Back
    </a>
    <br>
    <h1 class="text-3xl font-bold text-gray-900 mb-8">What did you think of {{ product.name }}?</h1>
    <div class="mb-8">
        <div class="flex gap-2 justify-center mb-8">
            {% for i in range(5) %}
            <a data-test-id="add-review-link-{{i}}" aria-label="Rate {{ i + 1 }} out of 5 stars"
                href="/products/{{product.productID}}/add_review?rating={{ i + 1 }}" class="hover:scale-110 transition-transform">
                <img class="w-12 h-12" src="{{ stars[i] }}" alt="Star">
            </a>
            {% endfor %}
        </div>
        <a data-test-id="next-button"
            href="/products/{{product.productID}}/add_review_message?rating={{ rating }}"
            class="inline-block px-6 py-3 bg-amber-700 text-white rounded-md hover:bg-amber-600 font-medium">Next</a>
    </div>
</main>
{% endblock %}