{% extends "layout.njk" %}
{% block head %}
<link rel="stylesheet" href="/basket.css">
{% endblock %}
{% block title %}
Basket
{% endblock %}
{% block content %}
<main>
    <h1>Basket</h1>
    {% if items|length %}
    <ul class="basket-products-list">
        {% for item in items %}
        <li>
            <div class="space-between">
                <div>
                    <h3>{{ item.name }}</h3>
                    <p>{{ item.description }}</p>
                </div>
                <div class="text-align-right">
                    <p>Price: £{{ item.price | pounds }}</p>
                    <div class="quantity-controls">
                        Quantity:
                        <button>-</button>
                        <span>{{ item.quantity }}</span>
                        <button>+</button>
                    </div>
                    <p>Total: £{{ (item.price * item.quantity) | pounds }}</p>
                </div>
            </div>

        </li>
        {% endfor %}
        <li>
            <h2>Total: £{{ total | pounds }}</h2>
            <button class="main-button">Proceed to Checkout</button>
        </li>
    </ul>
    {% else %}
    <p>Your basket is empty.</p>
    {% endif %}
    {% endblock %}
</main>
