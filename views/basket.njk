{% extends "layout.njk" %}
{% block title %}
Basket
{% endblock %}
{% block content %}
<main class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Basket</h1>
    {% if error %}
    <p class="text-red-600 mb-4">{{ error }}</p>
    {% endif %}
    {% if items|length %}
    <div class="space-y-4 mb-8">
        {% for item in items %}
        <div class="bg-white border border-gray-200 rounded-lg p-6" data-test-id="product">
            <div class="flex justify-between items-start gap-6 mb-4 flex-wrap">
                <div class="flex-1">
                    <h3 data-test-id="product-name" class="text-lg font-semibold text-gray-900 mb-2">{{ item.product.name }}</h3>
                    <p class="text-gray-600">{{ item.product.description }}</p>
                </div>
                <div class="text-right">
                    <p class="text-lg font-semibold text-gray-900">£{{ item.product.price | pounds }}</p>
                </div>
            </div>
            <div class="flex items-center justify-between flex-wrap gap-4 pt-4 border-t border-gray-200">
                <div class="flex items-center gap-3">
                    <span class="text-sm text-gray-600">Quantity:</span>
                    <div class="flex items-center gap-2">
                        <form action="/basket" method="post" class="inline">
                            <input type="number" name="productID" hidden value="{{item.product.productID}}">
                            <input type="number" name="quantity" hidden value="-1">
                            <input type="text" name="quantityMode" hidden value="relative">
                            <button type="submit" data-test-id="decrease-quantity" class="w-8 h-8 flex items-center justify-center bg-gray-200 text-gray-900 rounded hover:bg-gray-300">−</button>
                        </form>
                        <span data-test-id="quantity" class="w-8 text-center font-semibold">{{ item.quantity }}</span>
                        {% if item.quantity < item.product.quantity %}
                        <form action="/basket" method="post" class="inline">
                            <input type="number" name="productID" hidden value="{{item.product.productID}}">
                            <input type="number" name="quantity" hidden value="1">
                            <input type="text" name="quantityMode" hidden value="relative">
                            <button type="submit" data-test-id="increase-quantity" class="w-8 h-8 flex items-center justify-center bg-gray-200 text-gray-900 rounded hover:bg-gray-300">+</button>
                        </form>
                        {% endif %}
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-lg font-semibold text-gray-900">Total: £{{ (item.product.price * item.quantity) | pounds }}</p>
                </div>
            </div>
        </div>
        {% endfor %}
        <div class="bg-white border border-gray-200 rounded-lg p-6 mt-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Total: £{{ total | pounds }}</h2>
            <form action="/checkout" method="post">
                <button class="px-6 py-3 bg-amber-700 text-white rounded-md hover:bg-amber-600 font-medium" type="submit">Proceed to Checkout</button>
            </form>
        </div>
    </div>
    {% else %}
    <p class="text-gray-600 text-center py-8">Your basket is empty.</p>
    {% endif %}
</main>
{% endblock %}