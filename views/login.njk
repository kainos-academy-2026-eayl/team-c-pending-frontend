{% extends "layout.njk" %}
{% block title %}Login Page{% endblock %}
{% block header %}Login Page{% endblock %}
{% block content %}
<form method="POST" action="/login" class="main-page-form">
    {% if error %}
    <p style="color: red;">{{ error }}</p>
    {% endif %}
    <label for="email">Email:</label><br>
    <input type="email" data-test-id="email" id="email" name="email" value="{{ email or '' }}">
    <br>
    <label for="password">Password:</label><br>
    <div class="password-field">
        <input type="{% if passwordVisible %}text{% else %}password{% endif %}" data-test-id="password" id="password"
            name="password" value="{{ password or '' }}">
        <button class="main-button" type="submit" name="passwordVisibility"
            value="{% if passwordVisible %}hide{% else %}show{% endif %}"
            aria-controls="password"
            aria-pressed="{% if passwordVisible %}true{% else %}false{% endif %}">{% if passwordVisible %}Hide{% else %}Show{% endif %}</button>
    </div>
    <br>
    <p><a href="/password-reset">Forgot your password?</a></p>
    <button class="main-button" data-test-id="login-button" type="submit">Login</button>
</form>
{% endblock %}