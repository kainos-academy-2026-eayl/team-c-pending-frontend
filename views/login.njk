{% extends "layout.njk" %}
{% block title %}Login Page{% endblock %}
{% block header %}Login Page{% endblock %}
{% block content %}
<main class="max-w-md mx-auto mt-12 px-4 py-8 bg-white rounded-lg shadow-md">
    <form method="POST" action="/login">
        {% if error %}
        <p class="text-red-600 mb-4">{{ error }}</p>
        {% endif %}
        <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email:</label>
            <input type="email" data-test-id="email" id="email" name="email" value="{{ email or '' }}" class="w-full px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
        </div>
        <div class="mb-4">
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password:</label>
            <div class="flex items-start gap-2">
                <input type="{% if passwordVisible %}text{% else %}password{% endif %}" data-test-id="password" id="password" name="password" value="{{ password or '' }}" class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
                <button class="flex-shrink-0 px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600" type="submit" data-test-id="show-password" name="passwordVisibility"
                    value="{% if passwordVisible %}hide{% else %}show{% endif %}" aria-controls="password"
                    aria-pressed="{% if passwordVisible %}true{% else %}false{% endif %}">{% if passwordVisible %}Hide{% else %}Show{% endif %}</button>
            </div>
        </div>
        <p class="text-sm text-gray-600 mb-2">Don't have an account? <a href="/register" class="text-amber-700 hover:text-amber-600">Click here!</a></p>
        <p class="text-sm text-gray-600 mb-6"><a href="/password-reset" class="text-amber-700 hover:text-amber-600">Forgot your password?</a></p>
        <button class="w-full px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600" data-test-id="login-button" type="submit">Login</button>
    </form>
</main>
{% endblock %}