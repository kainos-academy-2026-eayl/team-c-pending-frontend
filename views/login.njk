{% extends "layout.njk" %}
{% block title %}Login Page{% endblock %}
{% block header %}Login Page{% endblock %}
{% block content %}
<form method="POST" action="/login" class="main-page-form">
    {% if error %}
    <p style="color: red;">{{ error }}</p>
    {% endif %}
    <label for="email">Email:</label><br>
    <input type="email" id="email" name="email">
    <br>
    <label for="password">Password:</label><br>
    <div class="password-field">
        <input type="password" id="password" name="password">
        <button class="main-button show-password" type="button" id="toggle-password" aria-controls="password"><img
                src="/icons/showPassword.svg" alt="Show Password"></button>
    </div>
    <br>
    <button class="main-button" type="submit">Login</button>
</form>
<script defer src="/showPassword.js"></script>
{% endblock %}