{% extends "layout.njk" %}
{% block title %}Register Page{% endblock %}
{% block header %}Register Page{% endblock %}
{% block content %}
<main class="max-w-md mx-auto mt-12 px-4 py-8 bg-white rounded-lg shadow-md">
    <form method="POST" action="/register">
        {% if error %}
        <p class="text-red-600 mb-4">{{ error }}</p>
        {% endif %}
        <div class="mb-4">
            <label for="first-name" class="block text-sm font-medium text-gray-700 mb-1">Name:</label>
            <input type="text" data-test-id="first-name" id="first-name" name="first-name" value="{{ firstName or '' }}"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
        </div>
        <div class="mb-4">
            <label for="last-name" class="block text-sm font-medium text-gray-700 mb-1">Surname:</label>
            <input type="text" data-test-id="last-name" id="last-name" name="last-name" value="{{ lastName or '' }}"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
        </div>
        <div class="mb-4">
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email:</label>
            <input type="email" data-test-id="email" id="email" name="email" value="{{ email or '' }}"
                class="w-full px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
        </div>
        <div class="mb-4">
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password:</label>
            <div class="flex items-start gap-2">
                <input type="{% if visiblePasswordField == 'password' %}text{% else %}password{% endif %}"
                    data-test-id="password" id="password" name="password" value="{{ password or '' }}"
                    class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
                <button
                    class="flex-shrink-0 px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600"
                    type="submit" data-test-id="show-password" name="passwordVisibility"
                    value="{% if visiblePasswordField == 'password' %}hide-password{% else %}show-password{% endif %}"
                    aria-controls="password"
                    aria-pressed="{% if visiblePasswordField == 'password' %}true{% else %}false{% endif %}">{% if visiblePasswordField == 'password' %}Hide{% else %}Show{% endif %}</button>
            </div>
        </div>
        <div class="mb-4">
            <label for="confirm-password" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password:</label>
            <div class="flex items-start gap-2">
                <input data-test-id="confirm-password"
                    type="{% if visiblePasswordField == 'confirm-password' %}text{% else %}password{% endif %}"
                    id="confirm-password" name="confirm-password" value="{{ confirmPassword or '' }}"
                    class="flex-1 px-3 py-2 border border-gray-300 rounded-md text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-600">
                <button
                    class="flex-shrink-0 px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600"
                    type="submit" data-test-id="show-confirm-password" id="toggle-confirm-password"
                    aria-controls="confirm-password" name="passwordVisibility"
                    value="{% if visiblePasswordField == 'confirm-password' %}hide-confirm-password{% else %}show-confirm-password{% endif %}"
                    aria-pressed="{% if visiblePasswordField == 'confirm-password' %}true{% else %}false{% endif %}">{% if visiblePasswordField == 'confirm-password' %}Hide{% else %}Show{% endif %}</button>
            </div>
        </div>
        <p class="text-sm text-gray-600 mb-6">Already have an account? <a href="/login"
                class="text-amber-700 hover:text-amber-600">Click here!</a></p>
        <button
            class="w-full px-4 py-2 bg-amber-700 text-white rounded-md hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600"
            data-test-id="register-button" type="submit">Register</button>
    </form>
</main>
{% endblock %}
