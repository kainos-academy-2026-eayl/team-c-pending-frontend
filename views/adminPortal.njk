{% extends "layout.njk" %}
{% block title %}Admin Portal - {% if section == "customers" %}Customers{% else %}Products{% endif %}{% endblock %}
{% block head %}<link rel="stylesheet" href="/admin.css">{% endblock %}
{% block content %}
<main class="admin-portal">
    <h2>Admin portal</h2>
    <nav class="admin-navigation" aria-label="Admin sections">
        <a href="/admin/customers"{% if section == "customers" %} aria-current="page"{% endif %}>Edit customers</a>
        <a href="/admin/products"{% if section == "products" %} aria-current="page"{% endif %}>Edit products</a>
    </nav>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    {% if success %}<p role="status">{{ success }}</p>{% endif %}

    {% if section == "customers" %}
    <section aria-labelledby="customers-heading">
        <h2 id="customers-heading">Customers</h2>
        <form class="admin-filters" action="/admin/customers" method="get" role="search">
            <label for="customer-search">Search customers by name or email</label>
            <input id="customer-search" type="search" name="search" value="{{ search }}"
                placeholder="Name or email">
            <button class="main-button" type="submit">Search customers</button>
            <a href="/admin/customers">Clear search</a>
        </form>
        <p role="status">{{ customers | length }} customer(s) found.</p>
        {% for customer in customers %}
        <form class="admin-edit-form" action="/admin/customers/{{ customer.customerID }}?{{ filterQuery }}" method="post">
            <fieldset>
                <legend>CustomerID: {{ customer.customerID }} ({{ customer.role }})</legend>
                <label for="customer-first-{{ customer.customerID }}">First name</label>
                <input id="customer-first-{{ customer.customerID }}" name="firstName"
                    value="{{ customer.firstName }}" required>
                <label for="customer-last-{{ customer.customerID }}">Last name</label>
                <input id="customer-last-{{ customer.customerID }}" name="lastName"
                    value="{{ customer.lastName }}" required>
                <label for="customer-email-{{ customer.customerID }}">Email</label>
                <input id="customer-email-{{ customer.customerID }}" name="email" type="email"
                    value="{{ customer.email }}" required>
                <div class="admin-actions">
                    <button class="main-button" type="submit">Save customer</button>
                    <a class="admin-delete-button" href="/admin/customers/{{ customer.customerID }}/delete?{{ filterQuery }}">Delete customer</a>
                </div>
            </fieldset>
        </form>
        {% else %}
        <p>No customers found. Try a different name or email, or clear the search.</p>
        {% endfor %}
    </section>

    {% else %}
    <section aria-labelledby="products-heading">
        <h2 id="products-heading">Products</h2>
        <form class="admin-filters" action="/admin/products" method="get" role="search">
            <label for="product-search">Search products by name</label>
            <input id="product-search" type="search" name="search" value="{{ search }}"
                placeholder="Product name">
            <label for="product-category">Category</label>
            <select id="product-category" name="category">
                <option value="">All categories</option>
                {% for option in categories %}
                <option value="{{ option }}"{% if category == option %} selected{% endif %}>{{ option }}</option>
                {% endfor %}
            </select>
            <button class="main-button" type="submit">Filter products</button>
            <a href="/admin/products">Clear filters</a>
        </form>
        <p role="status">{{ products | length }} product(s) found.</p>
        {% for product in products %}
        <div class="admin-edit-form">
            <fieldset>
                <legend>ProductID: {{ product.productID }}</legend>
                <form action="/admin/products/{{ product.productID }}?{{ filterQuery }}" method="post">
                    <label for="product-name-{{ product.productID }}">Name</label>
                    <input id="product-name-{{ product.productID }}" name="name" value="{{ product.name }}" required>
                    <label for="product-price-{{ product.productID }}">Price (£)</label>
                    <input id="product-price-{{ product.productID }}" name="price" type="number" min="0" step="0.01"
                        value="{{ product.price }}" required>
                    <label for="product-description-{{ product.productID }}">Description</label>
                    <textarea id="product-description-{{ product.productID }}" name="description"
                        required>{{ product.description }}</textarea>
                    <label for="product-category-{{ product.productID }}">Category</label>
                    <input id="product-category-{{ product.productID }}" name="category" value="{{ product.category }}"
                        required>
                    <label for="product-quantity-{{ product.productID }}">Quantity</label>
                    <input id="product-quantity-{{ product.productID }}" name="quantity" type="number" min="0" step="1"
                        value="{{ product.quantity }}" required>
                    <label for="product-image-{{ product.productID }}">Image URL</label>
                    <input id="product-image-{{ product.productID }}" name="image" type="url"
                        value="{{ product.image or '' }}">
                    <div class="admin-actions">
                        <button class="main-button" type="submit">Save product</button>
                    </div>
                </form>
                <form action="/admin/products/{{ product.productID }}/visibility?{{ filterQuery }}" method="post">
                    <button class="main-button" type="submit" name="hide" value="{% if product.hide %}false{% else %}true{% endif %}">
                        {% if product.hide %}Add product{% else %}Delete product{% endif %}
                    </button>
                    <p>Deleting removes the product from browsing and all customers' baskets. Existing orders are unchanged. Adding it again does not restore basket entries.</p>
                </form>
            </fieldset>
        </div>
        {% else %}
        <p>No products found. Try a different name or category, or clear the filters.</p>
        {% endfor %}
    </section>
    {% endif %}
</main>
{% endblock %}
